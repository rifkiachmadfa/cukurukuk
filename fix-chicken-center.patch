 end
 
-local function getPivotCFrame(instance: Instance): CFrame?
-	if instance:IsA("BasePart") then
-		return instance.CFrame
-	elseif instance:IsA("Model") then
-		return instance:GetPivot()
+-- Bounding box (centre CFrame + size) of a Model or BasePart; assumes the station stands upright.
+local function getBounds(instance: Instance): (CFrame?, Vector3?)
+	if instance:IsA("Model") then
+		local cf, size = instance:GetBoundingBox()
+		return cf, size
+	elseif instance:IsA("BasePart") then
+		return instance.CFrame, instance.Size
 	end
-	return nil
+	return nil, nil
+end
+
+-- Centre of the station's top surface: X/Z of the bounding-box centre, Y = top of the box.
+local function getTopCenter(instance: Instance): Vector3?
+	local cf, size = getBounds(instance)
+	if cf == nil or size == nil then
+		return nil
+	end
+	return Vector3.new(cf.Position.X, cf.Position.Y + size.Y / 2, cf.Position.Z)
+end
+
+-- Puts the model's bounding-box centre above `surface` so its bottom rests on the surface, centred in X/Z.
+-- Uses the bounding box (not the pivot), so an off-centre pivot in the chicken model does not matter.
+local function placeOnSurface(model: Model, surface: Vector3, extraOffset: Vector3)
+	local cf, size = model:GetBoundingBox()
+	local desiredCenter = Vector3.new(surface.X, surface.Y + size.Y / 2, surface.Z) + extraOffset
+	model:PivotTo(model:GetPivot() + (desiredCenter - cf.Position))
 end
 
