@@ -0,0 +1,198 @@
+--!strict
+--[[
+	OrderSelfTest — DEVELOPMENT ONLY. Plain-assert tests for OrderService (Phase 3.7).
+	Runs in Studio on server start (OrderConfig.Debug.RunSelfTest). Uses a fake clock and its own
+	OrderService instance, so it never touches live order state. Prints PASS/FAIL per case.
+
+	Not covered (needs a live Player/Studio session): remote spam, TooFar, prompt UI. See the manual
+	checklist in ai/PHASE_3_ORDERSYSTEM.md.
+]]
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local OrderTypes = require(ReplicatedStorage.Shared.Types.OrderTypes)
+local OrderServiceModule = require(script.Parent.Parent.OrderService)
+
+local LOG = "[OrderSelfTest]"
+
+local OrderSelfTest = {}
+
+function OrderSelfTest.Run(config: OrderTypes.OrderConfig): (number, number)
+	local passed, failed = 0, 0
+	local clock = 1000
+
+	local function newService()
+		return OrderServiceModule.new(config, {
+			runId = "test",
+			now = function()
+				return clock
+			end,
+		})
+	end
+
+	local function check(name: string, condition: boolean)
+		if condition then
+			passed += 1
+			print(LOG, "PASS", name)
+		else
+			failed += 1
+			warn(LOG, "FAIL", name)
+		end
+	end
+
+	local function line(sambalId: string, quantity: number): OrderTypes.OrderLine
+		return { recipeId = config.DefaultRecipeId, sambalId = sambalId, quantity = quantity }
+	end
+
+	-- create + unique ids
+	do
+		local service = newService()
+		local ok1, id1 = service:CreateOrder({ customerId = "c1" })
+		local ok2, id2 = service:CreateOrder({ customerId = "c2" })
+		check("create returns ok and unique ids", ok1 and ok2 and id1 ~= id2)
+		check("new order is Presented with deadline", service:GetStatus(id1) == "Presented")
+		local summary = service:GetSummary(id1)
+		check(
+			"presented deadline uses PresentedTimeoutSeconds",
+			summary ~= nil and summary.deadlineAt == clock + config.PresentedTimeoutSeconds
+		)
+		service:Destroy()
+	end
+
+	-- max 3 geprek
+	do
+		local service = newService()
+		check("3 geprek accepted", (service:CreateOrder({ customerId = "a", lines = { line("sedang", 3) } })))
+		check("4 geprek rejected", not (service:CreateOrder({ customerId = "b", lines = { line("sedang", 4) } })))
+		check(
+			"2+2 geprek across lines rejected",
+			not (service:CreateOrder({ customerId = "c", lines = { line("sedang", 2), line("pedas", 2) } }))
+		)
+		check("unknown sambal rejected", not (service:CreateOrder({ customerId = "d", lines = { line("nope", 1) } })))
+		check("zero quantity rejected", not (service:CreateOrder({ customerId = "e", lines = { line("sedang", 0) } })))
+		check("fractional quantity rejected", not (service:CreateOrder({ customerId = "f", lines = { line("sedang", 1.5) } })))
+		check("empty lines rejected", not (service:CreateOrder({ customerId = "g", lines = {} })))
+		service:Destroy()
+	end
+
+	-- generated orders always respect the cap
+	do
+		local service = newService()
+		local rng = Random.new(1234)
+		local allValid = true
+		for _ = 1, 300 do
+			local lines = service:GenerateLines(rng)
+			local valid = service:ValidateLines(lines)
+			if not valid then
+				allValid = false
+			end
+		end
+		check("300 generated orders are valid (<= max geprek)", allValid)
+		service:Destroy()
+	end
+
+	-- pricing from config
+	do
+		local service = newService()
+		local _, id = service:CreateOrder({ customerId = "p", lines = { line("sedang", 2), line("extra_pedas", 1) } })
+		local summary = service:GetSummary(id)
+		local expected = 2 * (config.Recipes[config.DefaultRecipeId].basePrice + config.Sambal.sedang.extraPrice)
+			+ (config.Recipes[config.DefaultRecipeId].basePrice + config.Sambal.extra_pedas.extraPrice)
+		check("total price computed from config", summary ~= nil and summary.totalPrice == expected)
+		service:Destroy()
+	end
+
+	-- duplicate order per customer
+	do
+		local service = newService()
+		local _, id = service:CreateOrder({ customerId = "dup" })
+		local ok, code = service:CreateOrder({ customerId = "dup" })
+		check("second active order for same customer rejected", not ok and code == "CustomerHasActiveOrder")
+		service:CancelOrder(id)
+		check("customer can order again after cancel", (service:CreateOrder({ customerId = "dup" })))
+		service:Destroy()
+	end
+
+	-- legal / illegal transitions + finished orders locked
+	do
+		local service = newService()
+		local _, id = service:CreateOrder({ customerId = "t" })
+		check("Presented -> Served is illegal", not (service:Transition(id, "Served")))
+		check("Presented -> Ready is illegal", not (service:Transition(id, "Ready")))
+		check("Presented -> Accepted ok", (service:Transition(id, "Accepted")))
+		check("accepted deadline = work limit", (service:GetSummary(id) :: any).deadlineAt == clock + config.WorkTimeLimitSeconds)
+		check("Accepted -> Served is illegal", not (service:Transition(id, "Served")))
+		check("Accepted -> Cooking ok", (service:Transition(id, "Cooking")))
+		check("Cooking -> Ready ok", (service:Transition(id, "Ready")))
+		check("Ready -> Served ok", (service:Transition(id, "Served")))
+		check("Served cannot be served twice", not (service:Transition(id, "Served")))
+		check("Served cannot be cancelled", not (service:Transition(id, "Cancelled")))
+		check("Served order has no deadline", (service:GetSummary(id) :: any).deadlineAt == nil)
+		check("customer slot freed after Served", service:GetActiveOrderIdForCustomer("t") == nil)
+		check("unknown order id rejected", not (service:Transition("missing", "Accepted")))
+		service:Destroy()
+	end
+
+	-- refuse / cancel / expire blocks serving
+	do
+		local service = newService()
+		local _, refusedId = service:CreateOrder({ customerId = "r" })
+		service:Transition(refusedId, "Refused")
+		check("refused order cannot be accepted", not (service:Transition(refusedId, "Accepted")))
+
+		local _, cancelledId = service:CreateOrder({ customerId = "x" })
+		service:Transition(cancelledId, "Accepted")
+		service:Transition(cancelledId, "Cooking")
+		service:Transition(cancelledId, "Ready")
+		service:CancelOrder(cancelledId, "CustomerLeft")
+		check("cancelled order cannot be served", not (service:Transition(cancelledId, "Served")))
+
+		local _, expiredId = service:CreateOrder({ customerId = "y" })
+		service:ExpireOrder(expiredId, "PresentedTimeout")
+		check("expired order cannot be accepted", not (service:Transition(expiredId, "Accepted")))
+		service:Destroy()
+	end
+
+	-- late guard: serving after the 2-minute limit expires instead of paying out
+	do
+		local service = newService()
+		local _, id = service:CreateOrder({ customerId = "late" })
+		service:Transition(id, "Accepted")
+		service:Transition(id, "Cooking")
+		service:Transition(id, "Ready")
+		clock += config.WorkTimeLimitSeconds + 1
+		local ok, code = service:Transition(id, "Served")
+		check("serving after work limit is rejected", not ok and code == "OrderExpired")
+		check("late order ends Expired", service:GetStatus(id) == "Expired")
+		clock = 1000
+		service:Destroy()
+	end
+
+	-- cleanup helpers
+	do
+		local service = newService()
+		service:CreateOrder({ customerId = "k1" })
+		service:CreateOrder({ customerId = "k2" })
+		check("CancelAllForCustomer cancels one", service:CancelAllForCustomer("k1", "CustomerLeft") == 1)
+		check("CancelAll cancels the rest", service:CancelAll("ShopClosed") == 1)
+		check("no active orders remain", #service:GetActiveSummaries() == 0)
+		service:Destroy()
+	end
+
+	-- summaries never leak server-only fields
+	do
+		local service = newService()
+		local _, id = service:CreateOrder({ customerId = "leak", customerCategory = "Secret", metadata = { isAnomaly = true } })
+		local summary = service:GetSummary(id) :: any
+		check(
+			"summary hides category and metadata",
+			summary.customerCategory == nil and summary.metadata == nil and summary.isAnomaly == nil
+		)
+		service:Destroy()
+	end
+
+	print(LOG, string.format("done: %d passed, %d failed", passed, failed))
+	return passed, failed
+end
+
+return OrderSelfTest
diff --git a/src/ServerScriptService/Services/OrderActionHandler.luau b/src/ServerScriptService/Services/OrderActionHandler.luau
new file mode 100644
index 0000000..60ae312
--- /dev/null
+++ b/src/ServerScriptService/Services/OrderActionHandler.luau
@@ -0,0 +1,140 @@
+--!strict
+--[[
+	OrderActionHandler — validates player intents (Accept / Refuse / Serve) before touching order state (Phase 3.2 + 3.5).
+
+	The client only supplies an action name and an orderId. Everything else (status, price, customer,
+	category, reward) is read from server state. Rewards/reputation are NOT applied here: Economy and
+	Reputation services (Phase 5) will react to OrderService.OrderChanged (Served / Refused).
+
+	Validation order: action -> orderId format -> cooldown -> game-state gate -> order exists ->
+	status matches action -> character alive -> interaction point -> distance -> transition.
+
+	Result codes: Ok, InvalidAction, InvalidOrderId, Cooldown, NotAllowed, NotFound, WrongStatus,
+	NoCharacter, NoInteractionPoint, TooFar, or a code from OrderService.Transition.
+]]
+
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local OrderTypes = require(ReplicatedStorage.Shared.Types.OrderTypes)
+local OrderServiceModule = require(script.Parent.OrderService)
+
+type OrderAction = OrderTypes.OrderAction
+type OrderStatus = OrderTypes.OrderStatus
+type ActionResult = OrderTypes.ActionResult
+
+local ACTION_TARGET: { [string]: OrderStatus } = {
+	Accept = "Accepted",
+	Refuse = "Refused",
+	Serve = "Served",
+}
+
+local ACTION_REQUIRED_STATUS: { [string]: OrderStatus } = {
+	Accept = "Presented",
+	Refuse = "Presented",
+	Serve = "Ready",
+}
+
+local OrderActionHandler = {}
+OrderActionHandler.__index = OrderActionHandler
+
+export type InteractionPointProvider = (orderId: string, action: OrderAction) -> Vector3?
+-- Future hook for DayCycle/Session: return (false, code) when actions are not allowed (e.g. Closing phase).
+export type ActionGate = (player: Player, action: OrderAction) -> (boolean, string?)
+
+export type OrderActionHandler = typeof(setmetatable({} :: {
+	_orderService: OrderServiceModule.OrderService,
+	_config: OrderTypes.OrderConfig,
+	_getPoint: InteractionPointProvider?,
+	_gate: ActionGate?,
+	_lastActionAt: { [number]: number },
+	_removingConnection: RBXScriptConnection,
+}, OrderActionHandler))
+
+local function fail(code: string): ActionResult
+	return { ok = false, code = code }
+end
+
+function OrderActionHandler.new(orderService: OrderServiceModule.OrderService, config: OrderTypes.OrderConfig): OrderActionHandler
+	local lastActionAt: { [number]: number } = {}
+	local removingConnection = Players.PlayerRemoving:Connect(function(player)
+		lastActionAt[player.UserId] = nil
+	end)
+	return setmetatable({
+		_orderService = orderService,
+		_config = config,
+		_getPoint = nil,
+		_gate = nil,
+		_lastActionAt = lastActionAt,
+		_removingConnection = removingConnection,
+	}, OrderActionHandler)
+end
+
+function OrderActionHandler.SetInteractionPointProvider(self: OrderActionHandler, provider: InteractionPointProvider?)
+	self._getPoint = provider
+end
+
+function OrderActionHandler.SetActionGate(self: OrderActionHandler, gate: ActionGate?)
+	self._gate = gate
+end
+
+-- `action` and `orderId` come from the client and are untrusted (typed `any`).
+function OrderActionHandler.Handle(self: OrderActionHandler, player: Player, action: any, orderId: any): ActionResult
+	local cfg = self._config
+
+	if type(action) ~= "string" or ACTION_TARGET[action] == nil then
+		return fail("InvalidAction")
+	end
+	if type(orderId) ~= "string" or #orderId == 0 or #orderId > cfg.MaxIdLength or string.find(orderId, "^[%w_%-]+$") == nil then
+		return fail("InvalidOrderId")
+	end
+
+	local now = os.clock()
+	local last = self._lastActionAt[player.UserId]
+	if last ~= nil and now - last < cfg.ActionCooldownSeconds then
+		return fail("Cooldown")
+	end
+	self._lastActionAt[player.UserId] = now
+
+	local gate = self._gate
+	if gate then
+		local allowed, code = gate(player, action :: OrderAction)
+		if not allowed then
+			return fail(code or "NotAllowed")
+		end
+	end
+
+	local summary = self._orderService:GetSummary(orderId)
+	if summary == nil then
+		return fail("NotFound")
+	end
+	if summary.status ~= ACTION_REQUIRED_STATUS[action] then
+		return fail("WrongStatus")
+	end
+
+	local character = player.Character
+	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
+	local root = character and character:FindFirstChild("HumanoidRootPart")
+	if humanoid == nil or humanoid.Health <= 0 or root == nil or not root:IsA("BasePart") then
+		return fail("NoCharacter")
+	end
+
+	local getPoint = self._getPoint
+	local point = if getPoint then getPoint(orderId, action :: OrderAction) else nil
+	if point == nil then
+		return fail("NoInteractionPoint")
+	end
+	if (root.Position - point).Magnitude > cfg.MaxInteractDistance then
+		return fail("TooFar")
+	end
+
+	local ok, code = self._orderService:Transition(orderId, ACTION_TARGET[action], "Player" .. action)
+	return { ok = ok, code = code }
+end
+
+function OrderActionHandler.Destroy(self: OrderActionHandler)
+	self._removingConnection:Disconnect()
+	table.clear(self._lastActionAt)
+end
+
+return OrderActionHandler
diff --git a/src/ServerScriptService/Services/OrderRemotes.luau b/src/ServerScriptService/Services/OrderRemotes.luau
new file mode 100644
index 0000000..1204124
--- /dev/null
+++ b/src/ServerScriptService/Services/OrderRemotes.luau
@@ -0,0 +1,100 @@
+--!strict
+--[[
+	OrderRemotes — remote contract for the OrderSystem (Phase 3.2).
+
+	Created under ReplicatedStorage.<Remotes.FolderName> (names in OrderConfig.Remotes):
+
+	RemoteFunction RequestOrderAction (client -> server)
+		args:    action: "Accept" | "Refuse" | "Serve", orderId: string
+		returns: { ok: boolean, code: string }   -- never contains server data
+	RemoteFunction RequestOrderSnapshot (client -> server)
+		args:    none
+		returns: { OrderSummary }                 -- active orders only, client-safe fields
+	RemoteEvent OrderUpdated (server -> client)
+		args:    OrderSummary                     -- fired on creation and every status change
+
+	The client may never send price, reward, category, status or any decision result.
+]]
+
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local OrderTypes = require(ReplicatedStorage.Shared.Types.OrderTypes)
+local OrderServiceModule = require(script.Parent.OrderService)
+local OrderActionHandlerModule = require(script.Parent.OrderActionHandler)
+
+local LOG = "[OrderRemotes]"
+local SNAPSHOT_COOLDOWN_SECONDS = 1
+
+local OrderRemotes = {}
+
+export type Handle = { Destroy: () -> () }
+
+local function getOrCreate(parent: Instance, className: string, name: string): Instance
+	local existing = parent:FindFirstChild(name)
+	if existing and existing.ClassName == className then
+		return existing
+	end
+	if existing then
+		existing:Destroy()
+	end
+	local created = Instance.new(className)
+	created.Name = name
+	created.Parent = parent
+	return created
+end
+
+function OrderRemotes.Start(
+	orderService: OrderServiceModule.OrderService,
+	handler: OrderActionHandlerModule.OrderActionHandler,
+	config: OrderTypes.OrderConfig
+): Handle
+	local names = config.Remotes
+	local folder = getOrCreate(ReplicatedStorage, "Folder", names.FolderName)
+	local actionFunction = getOrCreate(folder, "RemoteFunction", names.ActionFunction) :: RemoteFunction
+	local snapshotFunction = getOrCreate(folder, "RemoteFunction", names.SnapshotFunction) :: RemoteFunction
+	local updateEvent = getOrCreate(folder, "RemoteEvent", names.UpdateEvent) :: RemoteEvent
+
+	actionFunction.OnServerInvoke = function(player: Player, action: any, orderId: any)
+		local ok, result = pcall(handler.Handle, handler, player, action, orderId)
+		if not ok then
+			warn(LOG, "Handle failed:", result)
+			return { ok = false, code = "InternalError" }
+		end
+		return { ok = result.ok, code = result.code }
+	end
+
+	local lastSnapshotAt: { [number]: number } = {}
+	snapshotFunction.OnServerInvoke = function(player: Player)
+		local now = os.clock()
+		local last = lastSnapshotAt[player.UserId]
+		if last ~= nil and now - last < SNAPSHOT_COOLDOWN_SECONDS then
+			return {}
+		end
+		lastSnapshotAt[player.UserId] = now
+		return orderService:GetActiveSummaries()
+	end
+
+	local removing = Players.PlayerRemoving:Connect(function(player)
+		lastSnapshotAt[player.UserId] = nil
+	end)
+	local createdConnection = orderService.OrderCreated:Connect(function(summary)
+		updateEvent:FireAllClients(summary)
+	end)
+	local changedConnection = orderService.OrderChanged:Connect(function(_orderId, _from, _to, summary)
+		updateEvent:FireAllClients(summary)
+	end)
+
+	return {
+		Destroy = function()
+			actionFunction.OnServerInvoke = nil :: any
+			snapshotFunction.OnServerInvoke = nil :: any
+			removing:Disconnect()
+			createdConnection:Disconnect()
+			changedConnection:Disconnect()
+			folder:Destroy()
+		end,
+	}
+end
+
+return OrderRemotes
diff --git a/src/ServerScriptService/Services/OrderScreenService.luau b/src/ServerScriptService/Services/OrderScreenService.luau
new file mode 100644
index 0000000..d93ca0c
--- /dev/null
+++ b/src/ServerScriptService/Services/OrderScreenService.luau
@@ -0,0 +1,352 @@
+--!strict
+--[[
+	OrderScreenService — renders the current order on the world part named "screen" (Phase 3.4).
+
+	- Finds Workspace part by OrderConfig.Screen.PartName (case-insensitive). Waits for it if streamed in later.
+	- Builds a SurfaceGui (server-created, so every client sees the same server-authoritative text).
+	- Shows: portion count, sambal choice, price per line, total, status and a countdown.
+	- Adds ProximityPrompts (Terima / Tolak / Antar) that call OrderActionHandler; the server still validates everything.
+	- The countdown refreshes once per second only while an order with a deadline is displayed.
+]]
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local OrderTypes = require(ReplicatedStorage.Shared.Types.OrderTypes)
+local CurrencyFormat = require(ReplicatedStorage.Shared.Util.CurrencyFormat)
+local OrderServiceModule = require(script.Parent.OrderService)
+local OrderActionHandlerModule = require(script.Parent.OrderActionHandler)
+
+type OrderSummary = OrderTypes.OrderSummary
+
+local LOG = "[OrderScreenService]"
+local GUI_NAME = "OrderScreenGui"
+
+local STATUS_TEXT: { [string]: string } = {
+	Created = "Pesanan baru",
+	Presented = "Menunggu keputusan",
+	Accepted = "Diterima — siapkan pesanan",
+	Cooking = "Sedang dimasak",
+	Ready = "Siap diantar",
+	Served = "Selesai — pesanan diantar",
+	Refused = "Pesanan ditolak",
+	Cancelled = "Pesanan dibatalkan",
+	Expired = "Waktu habis",
+}
+
+local TERMINAL: { [string]: boolean } = { Served = true, Refused = true, Cancelled = true, Expired = true }
+
+local OrderScreenService = {}
+
+export type Handle = {
+	GetPosition: () -> Vector3?,
+	Destroy: () -> (),
+}
+
+local function findScreenPart(name: string): BasePart?
+	local direct = workspace:FindFirstChild(name, true)
+	if direct and direct:IsA("BasePart") then
+		return direct
+	end
+	local lowered = string.lower(name)
+	for _, instance in workspace:GetDescendants() do
+		if instance:IsA("BasePart") and string.lower(instance.Name) == lowered then
+			return instance
+		end
+	end
+	return nil
+end
+
+local function makeLabel(parent: Instance, name: string, position: UDim2, size: UDim2, textSize: number, bold: boolean): TextLabel
+	local label = Instance.new("TextLabel")
+	label.Name = name
+	label.BackgroundTransparency = 1
+	label.Position = position
+	label.Size = size
+	label.Font = if bold then Enum.Font.GothamBold else Enum.Font.Gotham
+	label.TextSize = textSize
+	label.TextColor3 = Color3.fromRGB(245, 240, 225)
+	label.TextXAlignment = Enum.TextXAlignment.Left
+	label.TextYAlignment = Enum.TextYAlignment.Top
+	label.TextWrapped = true
+	label.Text = ""
+	label.Parent = parent
+	return label
+end
+
+local function formatCountdown(seconds: number): string
+	local whole = math.max(0, math.ceil(seconds))
+	return string.format("%d:%02d", whole // 60, whole % 60)
+end
+
+function OrderScreenService.Start(
+	orderService: OrderServiceModule.OrderService,
+	handler: OrderActionHandlerModule.OrderActionHandler,
+	config: OrderTypes.OrderConfig
+): Handle
+	local screenCfg = config.Screen
+
+	local screenPart: BasePart? = nil
+	local gui: SurfaceGui? = nil
+	local statusLabel: TextLabel? = nil
+	local linesLabel: TextLabel? = nil
+	local totalLabel: TextLabel? = nil
+	local timerLabel: TextLabel? = nil
+	local prompts: { [string]: ProximityPrompt } = {}
+	local promptConnections: { RBXScriptConnection } = {}
+	local streamConnection: RBXScriptConnection? = nil
+
+	local displayed: OrderSummary? = nil
+	local lastResult: OrderSummary? = nil
+	local resultToken = 0
+	local tickerRunning = false
+	local destroyed = false
+
+	local function updateTimerLabel()
+		local label = timerLabel
+		local summary = displayed
+		if label == nil then
+			return
+		end
+		if summary == nil or summary.deadlineAt == nil then
+			label.Text = ""
+			return
+		end
+		local remaining = summary.deadlineAt - orderService:GetNow()
+		local caption = if summary.deadlineKind == "Work" then "Batas pengerjaan" else "Pelanggan menunggu"
+		label.Text = string.format("%s: %s", caption, formatCountdown(remaining))
+	end
+
+	local function render()
+		local summary = displayed
+		if statusLabel == nil or linesLabel == nil or totalLabel == nil then
+			return
+		end
+		if summary == nil then
+			statusLabel.Text = "Belum ada pesanan"
+			linesLabel.Text = ""
+			totalLabel.Text = ""
+			updateTimerLabel()
+		else
+			statusLabel.Text = STATUS_TEXT[summary.status] or summary.status
+			local rows: { string } = {}
+			for _, line in summary.lines do
+				table.insert(
+					rows,
+					string.format(
+						"%dx %s  •  Sambal %s  •  %s",
+						line.quantity,
+						line.displayName,
+						line.sambalName,
+						CurrencyFormat.formatRupiah(line.lineTotal)
+					)
+				)
+			end
+			linesLabel.Text = table.concat(rows, "\n")
+			totalLabel.Text = string.format(
+				"Total (%d porsi): %s",
+				summary.totalQuantity,
+				CurrencyFormat.formatRupiah(summary.totalPrice)
+			)
+			updateTimerLabel()
+		end
+
+		local status = if summary then summary.status else nil
+		local acceptPrompt, refusePrompt, servePrompt = prompts.Accept, prompts.Refuse, prompts.Serve
+		if acceptPrompt then
+			acceptPrompt.Enabled = status == "Presented"
+		end
+		if refusePrompt then
+			refusePrompt.Enabled = status == "Presented"
+		end
+		if servePrompt then
+			servePrompt.Enabled = status == "Ready"
+		end
+	end
+
+	local function ensureTicker()
+		local summary = displayed
+		if tickerRunning or summary == nil or summary.deadlineAt == nil then
+			return
+		end
+		tickerRunning = true
+		task.spawn(function()
+			while not destroyed and displayed ~= nil and displayed.deadlineAt ~= nil do
+				updateTimerLabel()
+				task.wait(1)
+			end
+			tickerRunning = false
+		end)
+	end
+
+	local function refresh()
+		local newest = orderService:GetNewestActiveSummary()
+		if newest then
+			displayed = newest
+			lastResult = nil
+		elseif lastResult then
+			displayed = lastResult
+		else
+			displayed = nil
+		end
+		render()
+		ensureTicker()
+	end
+
+	local function makePrompt(part: BasePart, key: string, actionText: string, keyCode: Enum.KeyCode, gamepad: Enum.KeyCode, action: OrderTypes.OrderAction)
+		local name = "Order" .. key .. "Prompt"
+		local old = part:FindFirstChild(name)
+		if old then
+			old:Destroy()
+		end
+		local prompt = Instance.new("ProximityPrompt")
+		prompt.Name = name
+		prompt.ActionText = actionText
+		prompt.ObjectText = "Pesanan"
+		prompt.HoldDuration = 0
+		prompt.KeyboardKeyCode = keyCode
+		prompt.GamepadKeyCode = gamepad
+		prompt.MaxActivationDistance = math.max(4, config.MaxInteractDistance - 2)
+		prompt.RequiresLineOfSight = false
+		prompt.Enabled = false
+		prompt.Parent = part
+		prompts[key] = prompt
+		table.insert(
+			promptConnections,
+			prompt.Triggered:Connect(function(player: Player)
+				local summary = displayed
+				if summary == nil then
+					return
+				end
+				handler:Handle(player, action, summary.orderId)
+			end)
+		)
+	end
+
+	local function attach(part: BasePart)
+		screenPart = part
+
+		local oldGui = part:FindFirstChild(GUI_NAME)
+		if oldGui then
+			oldGui:Destroy()
+		end
+
+		local face = Enum.NormalId.Front
+		local okFace, resolved = pcall(function()
+			return (Enum.NormalId :: any)[screenCfg.Face]
+		end)
+		if okFace and resolved then
+			face = resolved
+		else
+			warn(LOG, "Screen.Face tidak valid, memakai Front:", screenCfg.Face)
+		end
+
+		local surface = Instance.new("SurfaceGui")
+		surface.Name = GUI_NAME
+		surface.Face = face
+		surface.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
+		surface.CanvasSize = Vector2.new(800, 500)
+		surface.LightInfluence = 0
+		surface.Brightness = 1
+		surface.ClipsDescendants = true
+		surface.Adornee = part
+		surface.Parent = part
+		gui = surface
+
+		local background = Instance.new("Frame")
+		background.Name = "Background"
+		background.BackgroundColor3 = Color3.fromRGB(20, 18, 22)
+		background.BorderSizePixel = 0
+		background.Size = UDim2.fromScale(1, 1)
+		background.Parent = surface
+
+		local padding = Instance.new("UIPadding")
+		padding.PaddingLeft = UDim.new(0, 28)
+		padding.PaddingRight = UDim.new(0, 28)
+		padding.PaddingTop = UDim.new(0, 20)
+		padding.PaddingBottom = UDim.new(0, 20)
+		padding.Parent = background
+
+		local title = makeLabel(background, "Title", UDim2.fromScale(0, 0), UDim2.fromScale(1, 0.14), 44, true)
+		title.Text = "PESANAN"
+		title.TextColor3 = Color3.fromRGB(255, 170, 60)
+		statusLabel = makeLabel(background, "Status", UDim2.fromScale(0, 0.15), UDim2.fromScale(1, 0.1), 32, true)
+		linesLabel = makeLabel(background, "Lines", UDim2.fromScale(0, 0.27), UDim2.fromScale(1, 0.38), 30, false)
+		totalLabel = makeLabel(background, "Total", UDim2.fromScale(0, 0.68), UDim2.fromScale(1, 0.1), 32, true)
+		timerLabel = makeLabel(background, "Timer", UDim2.fromScale(0, 0.82), UDim2.fromScale(1, 0.1), 28, false)
+
+		makePrompt(part, "Accept", "Terima", Enum.KeyCode.E, Enum.KeyCode.ButtonX, "Accept")
+		makePrompt(part, "Refuse", "Tolak", Enum.KeyCode.F, Enum.KeyCode.ButtonY, "Refuse")
+		makePrompt(part, "Serve", "Antar", Enum.KeyCode.E, Enum.KeyCode.ButtonX, "Serve")
+
+		refresh()
+	end
+
+	local initial = findScreenPart(screenCfg.PartName)
+	if initial then
+		attach(initial)
+	else
+		warn(
+			LOG,
+			string.format(
+				"Part '%s' belum ditemukan di Workspace. Menunggu (mungkin StreamingEnabled) — pastikan nama part benar.",
+				screenCfg.PartName
+			)
+		)
+		local lowered = string.lower(screenCfg.PartName)
+		streamConnection = workspace.DescendantAdded:Connect(function(instance)
+			if screenPart == nil and instance:IsA("BasePart") and string.lower(instance.Name) == lowered then
+				if streamConnection then
+					streamConnection:Disconnect()
+					streamConnection = nil
+				end
+				attach(instance)
+			end
+		end)
+	end
+
+	local changedConnection = orderService.OrderChanged:Connect(function(_orderId, _from, toStatus, summary)
+		if TERMINAL[toStatus] then
+			lastResult = summary
+			resultToken += 1
+			local token = resultToken
+			task.delay(screenCfg.ResultDisplaySeconds, function()
+				if not destroyed and token == resultToken and lastResult ~= nil then
+					lastResult = nil
+					refresh()
+				end
+			end)
+		end
+		refresh()
+	end)
+	local createdConnection = orderService.OrderCreated:Connect(function()
+		refresh()
+	end)
+
+	return {
+		GetPosition = function()
+			local part = screenPart
+			return if part and part.Parent then part.Position else nil
+		end,
+		Destroy = function()
+			destroyed = true
+			changedConnection:Disconnect()
+			createdConnection:Disconnect()
+			if streamConnection then
+				streamConnection:Disconnect()
+			end
+			for _, connection in promptConnections do
+				connection:Disconnect()
+			end
+			table.clear(promptConnections)
+			for _, prompt in prompts do
+				prompt:Destroy()
+			end
+			table.clear(prompts)
+			if gui then
+				gui:Destroy()
+			end
+		end,
+	}
+end
+
+return OrderScreenService
diff --git a/src/ServerScriptService/Services/OrderService.luau b/src/ServerScriptService/Services/OrderService.luau
new file mode 100644
index 0000000..421fbd2
--- /dev/null
+++ b/src/ServerScriptService/Services/OrderService.luau
@@ -0,0 +1,471 @@
+--!strict
+--[[
+	OrderService — authoritative order state + lifecycle (Phase 3.1).
+
+	One instance per run (OrderService.new). The server is the only writer of order state.
+	Clients never send price/quantity/status; they only send intents (see OrderActionHandler).
+
+	Lifecycle (legal transitions):
+		Created   -> Presented | Cancelled | Expired
+		Presented -> Accepted | Refused | Cancelled | Expired
+		Accepted  -> Cooking | Cancelled | Expired
+		Cooking   -> Ready | Cancelled | Expired
+		Ready     -> Served | Cancelled | Expired
+		Served / Refused / Cancelled / Expired are terminal.
+
+	Who triggers what (server-side callers only):
+		Presented            OrderService.CreateOrder (default)
+		Accepted / Refused   OrderActionHandler (player intent, validated)
+		Cooking / Ready      CookingService (Phase 4)  <- not built yet; dev harness simulates it
+		Served               OrderActionHandler (player intent, validated)
+		Cancelled            OrderService.CancelOrder / CancelAll* (customer leaves, shop closes)
+		Expired              OrderTimeoutService (deadline exceeded)
+
+	Public API (all return plain values, never throw on bad input):
+		new(config, options?)
+		CreateOrder(params) -> (ok, orderIdOrCode)
+		GenerateLines(rng?) -> { OrderLine }
+		ValidateLines(lines) -> (ok, code)
+		Transition(orderId, toStatus, reason?) -> (ok, code)
+		CancelOrder(orderId, reason?) / ExpireOrder(orderId, reason?) -> (ok, code)
+		CancelAllForCustomer(customerId, reason?) -> number
+		CancelAll(reason?) -> number
+		GetSummary(orderId) -> OrderSummary?
+		GetStatus(orderId) -> OrderStatus?
+		GetCustomerCategory(orderId) -> CustomerType?   (server only; never replicate)
+		GetActiveOrderIdForCustomer(customerId) -> string?
+		GetActiveSummaries() -> { OrderSummary }  (oldest first)
+		GetNewestActiveSummary() -> OrderSummary?
+		GetNow() -> number
+		Destroy()
+	Signals:
+		OrderCreated(summary)
+		OrderChanged(orderId, fromStatus, toStatus, summary)
+]]
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local OrderTypes = require(ReplicatedStorage.Shared.Types.OrderTypes)
+local Signal = require(ReplicatedStorage.Shared.Util.Signal)
+
+type Order = OrderTypes.Order
+type OrderStatus = OrderTypes.OrderStatus
+type OrderConfig = OrderTypes.OrderConfig
+type OrderLine = OrderTypes.OrderLine
+type OrderSummary = OrderTypes.OrderSummary
+
+local LEGAL_TRANSITIONS: { [OrderStatus]: { [OrderStatus]: boolean } } = {
+	Created = { Presented = true, Cancelled = true, Expired = true },
+	Presented = { Accepted = true, Refused = true, Cancelled = true, Expired = true },
+	Accepted = { Cooking = true, Cancelled = true, Expired = true },
+	Cooking = { Ready = true, Cancelled = true, Expired = true },
+	Ready = { Served = true, Cancelled = true, Expired = true },
+	Served = {},
+	Refused = {},
+	Cancelled = {},
+	Expired = {},
+}
+
+local TERMINAL: { [OrderStatus]: boolean } = {
+	Served = true,
+	Refused = true,
+	Cancelled = true,
+	Expired = true,
+}
+
+local OrderService = {}
+OrderService.__index = OrderService
+
+export type Options = {
+	runId: string?,
+	now: (() -> number)?, -- injectable clock (tests)
+}
+
+export type OrderService = typeof(setmetatable({} :: {
+	_config: OrderConfig,
+	_runId: string,
+	_now: () -> number,
+	_orders: { [string]: Order },
+	_activeByCustomer: { [string]: string },
+	_finishedIds: { string },
+	_counter: number,
+	_destroyed: boolean,
+	OrderCreated: Signal.Signal,
+	OrderChanged: Signal.Signal,
+}, OrderService))
+
+local function weightedPick(keys: { any }, weights: { [any]: number }, rng: Random): any
+	local total = 0
+	for _, key in keys do
+		total += math.max(0, weights[key] or 0)
+	end
+	if total <= 0 then
+		return keys[1]
+	end
+	local roll = rng:NextNumber() * total
+	local acc = 0
+	for _, key in keys do
+		acc += math.max(0, weights[key] or 0)
+		if roll < acc then
+			return key
+		end
+	end
+	return keys[#keys]
+end
+
+function OrderService.new(config: OrderConfig, options: Options?): OrderService
+	local opts: Options = options or {}
+	local self = setmetatable({
+		_config = config,
+		_runId = opts.runId or "run",
+		_now = opts.now or function()
+			return workspace:GetServerTimeNow()
+		end,
+		_orders = {},
+		_activeByCustomer = {},
+		_finishedIds = {},
+		_counter = 0,
+		_destroyed = false,
+		OrderCreated = Signal.new(),
+		OrderChanged = Signal.new(),
+	}, OrderService)
+	return self
+end
+
+function OrderService.GetNow(self: OrderService): number
+	return self._now()
+end
+
+-- Returns (ok, code). Codes: InvalidLines, InvalidLineCount, InvalidLine, UnknownRecipe,
+-- UnknownSambal, InvalidQuantity, TooManyGeprek
+function OrderService.ValidateLines(self: OrderService, lines: any): (boolean, string)
+	local cfg = self._config
+	if type(lines) ~= "table" then
+		return false, "InvalidLines"
+	end
+	local count = #lines
+	if count < 1 or count > cfg.MaxLinesPerOrder then
+		return false, "InvalidLineCount"
+	end
+	local geprekTotal = 0
+	for index = 1, count do
+		local line = lines[index]
+		if type(line) ~= "table" then
+			return false, "InvalidLine"
+		end
+		local recipeId, sambalId, quantity = line.recipeId, line.sambalId, line.quantity
+		if type(recipeId) ~= "string" or cfg.Recipes[recipeId] == nil then
+			return false, "UnknownRecipe"
+		end
+		if type(sambalId) ~= "string" or cfg.Sambal[sambalId] == nil then
+			return false, "UnknownSambal"
+		end
+		if type(quantity) ~= "number" or quantity % 1 ~= 0 or quantity < 1 or quantity > cfg.MaxGeprekPerOrder then
+			return false, "InvalidQuantity"
+		end
+		if cfg.Recipes[recipeId].isGeprek then
+			geprekTotal += quantity
+		end
+	end
+	if geprekTotal > cfg.MaxGeprekPerOrder then
+		return false, "TooManyGeprek"
+	end
+	return true, "Ok"
+end
+
+-- Server-side random order content, driven entirely by config weights.
+function OrderService.GenerateLines(self: OrderService, rng: Random?): { OrderLine }
+	local cfg = self._config
+	local random = rng or Random.new()
+
+	local portionKeys: { any } = {}
+	for portions in cfg.PortionWeights do
+		table.insert(portionKeys, portions)
+	end
+	table.sort(portionKeys, function(a, b)
+		return (a :: number) < (b :: number)
+	end)
+	local portionCount = math.clamp(weightedPick(portionKeys, cfg.PortionWeights :: any, random) :: number, 1, cfg.MaxGeprekPerOrder)
+
+	local sambalKeys: { any } = table.clone(cfg.SambalOrder :: any)
+	local sambalWeights: { [any]: number } = {}
+	for id, def in cfg.Sambal do
+		sambalWeights[id] = def.weight
+	end
+
+	local tally: { [string]: number } = {}
+	for _ = 1, portionCount do
+		local sambalId = weightedPick(sambalKeys, sambalWeights, random) :: string
+		tally[sambalId] = (tally[sambalId] or 0) + 1
+	end
+
+	local lines: { OrderLine } = {}
+	for _, sambalId in cfg.SambalOrder do
+		local quantity = tally[sambalId]
+		if quantity then
+			table.insert(lines, { recipeId = cfg.DefaultRecipeId, sambalId = sambalId, quantity = quantity })
+		end
+	end
+	return lines
+end
+
+-- Builds frozen normalized lines + pricing from already-validated lines.
+function OrderService._price(self: OrderService, lines: { OrderLine }): ({ OrderLine }, number, number)
+	local cfg = self._config
+	local normalized: { OrderLine } = {}
+	local totalQuantity, totalPrice = 0, 0
+	for _, line in lines do
+		local recipe = cfg.Recipes[line.recipeId]
+		local sambal = cfg.Sambal[line.sambalId]
+		local unitPrice = recipe.basePrice + sambal.extraPrice
+		totalQuantity += line.quantity
+		totalPrice += unitPrice * line.quantity
+		table.insert(
+			normalized,
+			table.freeze({ recipeId = line.recipeId, sambalId = line.sambalId, quantity = line.quantity })
+		)
+	end
+	return table.freeze(normalized), totalQuantity, totalPrice
+end
+
+function OrderService._summarize(self: OrderService, order: Order): OrderSummary
+	local cfg = self._config
+	local lines = {}
+	for _, line in order.lines do
+		local recipe = cfg.Recipes[line.recipeId]
+		local sambal = cfg.Sambal[line.sambalId]
+		local unitPrice = recipe.basePrice + sambal.extraPrice
+		table.insert(lines, {
+			recipeId = line.recipeId,
+			displayName = recipe.displayName,
+			sambalId = line.sambalId,
+			sambalName = sambal.displayName,
+			quantity = line.quantity,
+			unitPrice = unitPrice,
+			lineTotal = unitPrice * line.quantity,
+		})
+	end
+	return {
+		orderId = order.orderId,
+		customerId = order.customerId,
+		status = order.status,
+		lines = lines,
+		totalQuantity = order.totalQuantity,
+		totalPrice = order.totalPrice,
+		deadlineAt = order.deadlineAt,
+		deadlineKind = order.deadlineKind,
+		endReason = order.endReason,
+	}
+end
+
+-- Returns (ok, orderId) or (false, errorCode).
+-- Codes: ServiceDestroyed, InvalidCustomer, CustomerHasActiveOrder, + ValidateLines codes.
+function OrderService.CreateOrder(self: OrderService, params: OrderTypes.CreateOrderParams): (boolean, string)
+	if self._destroyed then
+		return false, "ServiceDestroyed"
+	end
+	local cfg = self._config
+	local customerId = params.customerId
+	if type(customerId) ~= "string" or #customerId == 0 or #customerId > cfg.MaxIdLength then
+		return false, "InvalidCustomer"
+	end
+	if self._activeByCustomer[customerId] ~= nil then
+		return false, "CustomerHasActiveOrder"
+	end
+
+	local rawLines: { OrderLine } = params.lines or self:GenerateLines(params.rng)
+	local valid, code = self:ValidateLines(rawLines)
+	if not valid then
+		return false, code
+	end
+	local lines, totalQuantity, totalPrice = self:_price(rawLines)
+
+	self._counter += 1
+	local orderId = string.format("%s-%04d", self._runId, self._counter)
+	local metadata: { [string]: any } = if params.metadata then table.clone(params.metadata) else {}
+
+	local order: Order = {
+		orderId = orderId,
+		seq = self._counter,
+		customerId = customerId,
+		customerCategory = params.customerCategory or "Normal",
+		lines = lines,
+		totalQuantity = totalQuantity,
+		totalPrice = totalPrice,
+		status = "Created",
+		createdAt = self._now(),
+		ownerUserId = params.ownerUserId,
+		metadata = metadata,
+	}
+	self._orders[orderId] = order
+	self._activeByCustomer[customerId] = orderId
+	self.OrderCreated:Fire(self:_summarize(order))
+
+	if params.present ~= false then
+		self:Transition(orderId, "Presented")
+	end
+	return true, orderId
+end
+
+function OrderService._applyTransition(self: OrderService, order: Order, toStatus: OrderStatus, reason: string?)
+	local cfg = self._config
+	local fromStatus = order.status
+	local now = self._now()
+	order.status = toStatus
+
+	if toStatus == "Presented" then
+		order.presentedAt = now
+		order.deadlineAt = now + cfg.PresentedTimeoutSeconds
+		order.deadlineKind = "Presented"
+	elseif toStatus == "Accepted" then
+		order.acceptedAt = now
+		order.deadlineAt = now + cfg.WorkTimeLimitSeconds
+		order.deadlineKind = "Work"
+	end
+
+	if TERMINAL[toStatus] then
+		order.finishedAt = now
+		order.deadlineAt = nil
+		order.deadlineKind = nil
+		order.endReason = reason
+		if self._activeByCustomer[order.customerId] == order.orderId then
+			self._activeByCustomer[order.customerId] = nil
+		end
+		table.insert(self._finishedIds, order.orderId)
+		while #self._finishedIds > cfg.MaxFinishedHistory do
+			local oldest = table.remove(self._finishedIds, 1)
+			if oldest then
+				self._orders[oldest] = nil
+			end
+		end
+	end
+
+	self.OrderChanged:Fire(order.orderId, fromStatus, toStatus, self:_summarize(order))
+end
+
+-- Returns (ok, code). Codes: ServiceDestroyed, InvalidOrderId, NotFound, IllegalTransition, OrderExpired, Ok
+function OrderService.Transition(self: OrderService, orderId: string, toStatus: OrderStatus, reason: string?): (boolean, string)
+	if self._destroyed then
+		return false, "ServiceDestroyed"
+	end
+	if type(orderId) ~= "string" then
+		return false, "InvalidOrderId"
+	end
+	local order = self._orders[orderId]
+	if order == nil then
+		return false, "NotFound"
+	end
+	local allowed = LEGAL_TRANSITIONS[order.status]
+	if allowed[toStatus] ~= true then
+		return false, "IllegalTransition"
+	end
+
+	-- Late guard: a deadline that already passed must not be beaten by a transition
+	-- that arrives before the timeout timer fires (no reward after expiry).
+	local deadlineAt = order.deadlineAt
+	if deadlineAt ~= nil and self._now() > deadlineAt and toStatus ~= "Expired" and toStatus ~= "Cancelled" then
+		self:_applyTransition(order, "Expired", "DeadlineExceeded")
+		return false, "OrderExpired"
+	end
+
+	self:_applyTransition(order, toStatus, reason)
+	return true, "Ok"
+end
+
+function OrderService.CancelOrder(self: OrderService, orderId: string, reason: string?): (boolean, string)
+	return self:Transition(orderId, "Cancelled", reason or "Cancelled")
+end
+
+function OrderService.ExpireOrder(self: OrderService, orderId: string, reason: string?): (boolean, string)
+	return self:Transition(orderId, "Expired", reason or "Expired")
+end
+
+function OrderService.CancelAllForCustomer(self: OrderService, customerId: string, reason: string?): number
+	local orderId = self._activeByCustomer[customerId]
+	if orderId and self:CancelOrder(orderId, reason or "CustomerLeft") then
+		return 1
+	end
+	return 0
+end
+
+-- Closing / day change / cleanup. Returns how many orders were cancelled.
+function OrderService.CancelAll(self: OrderService, reason: string?): number
+	local ids: { string } = {}
+	for orderId in self._activeByCustomer do
+		table.insert(ids, self._activeByCustomer[orderId])
+	end
+	local cancelled = 0
+	for _, orderId in ids do
+		if self:CancelOrder(orderId, reason or "Cleanup") then
+			cancelled += 1
+		end
+	end
+	return cancelled
+end
+
+function OrderService.GetSummary(self: OrderService, orderId: string): OrderSummary?
+	local order = if type(orderId) == "string" then self._orders[orderId] else nil
+	if order == nil then
+		return nil
+	end
+	return self:_summarize(order)
+end
+
+function OrderService.GetStatus(self: OrderService, orderId: string): OrderStatus?
+	local order = if type(orderId) == "string" then self._orders[orderId] else nil
+	return if order then order.status else nil
+end
+
+-- Server-only. Never put the result on a remote.
+function OrderService.GetCustomerCategory(self: OrderService, orderId: string): OrderTypes.CustomerType?
+	local order = if type(orderId) == "string" then self._orders[orderId] else nil
+	return if order then order.customerCategory else nil
+end
+
+function OrderService.GetActiveOrderIdForCustomer(self: OrderService, customerId: string): string?
+	return self._activeByCustomer[customerId]
+end
+
+function OrderService.GetActiveSummaries(self: OrderService): { OrderSummary }
+	local active: { Order } = {}
+	for _, orderId in self._activeByCustomer do
+		local order = self._orders[orderId]
+		if order then
+			table.insert(active, order)
+		end
+	end
+	table.sort(active, function(a, b)
+		return a.seq < b.seq
+	end)
+	local summaries: { OrderSummary } = {}
+	for _, order in active do
+		table.insert(summaries, self:_summarize(order))
+	end
+	return summaries
+end
+
+function OrderService.GetNewestActiveSummary(self: OrderService): OrderSummary?
+	local newest: Order? = nil
+	for _, orderId in self._activeByCustomer do
+		local order = self._orders[orderId]
+		if order and (newest == nil or order.seq > newest.seq) then
+			newest = order
+		end
+	end
+	return if newest then self:_summarize(newest) else nil
+end
+
+function OrderService.Destroy(self: OrderService)
+	if self._destroyed then
+		return
+	end
+	self:CancelAll("ServiceDestroyed")
+	self._destroyed = true
+	self.OrderCreated:DisconnectAll()
+	self.OrderChanged:DisconnectAll()
+	table.clear(self._orders)
+	table.clear(self._activeByCustomer)
+	table.clear(self._finishedIds)
+end
+
+return OrderService
diff --git a/src/ServerScriptService/Services/OrderSystem.luau b/src/ServerScriptService/Services/OrderSystem.luau
new file mode 100644
index 0000000..e81c546
--- /dev/null
+++ b/src/ServerScriptService/Services/OrderSystem.luau
@@ -0,0 +1,80 @@
+--!strict
+--[[
+	OrderSystem — composition root for the OrderSystem (Phase 3).
+	Wires OrderService + validation + remotes + world screen + timeouts. Start() once per server.
+
+	Later integration points (not built yet, do NOT fake them here):
+		CustomerService   -> handle.OrderService:CreateOrder({ customerId = ..., customerCategory = ... })
+		                     handle.Timeouts.OnCustomerLeft(customerId)
+		DayCycleService   -> handle.Timeouts.OnShopClosing("ShopClosed"); handle.ActionHandler:SetActionGate(...)
+		CookingService    -> handle.OrderService:Transition(orderId, "Cooking" | "Ready")
+		Economy/Reputation-> handle.OrderService.OrderChanged (toStatus == "Served" | "Refused")
+]]
+
+local HttpService = game:GetService("HttpService")
+local RunService = game:GetService("RunService")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local OrderConfig = require(ReplicatedStorage.Shared.Config.OrderConfig)
+local OrderService = require(script.Parent.OrderService)
+local OrderActionHandler = require(script.Parent.OrderActionHandler)
+local OrderRemotes = require(script.Parent.OrderRemotes)
+local OrderScreenService = require(script.Parent.OrderScreenService)
+local OrderTimeoutService = require(script.Parent.OrderTimeoutService)
+local OrderDevHarness = require(script.Parent.Dev.OrderDevHarness)
+local OrderSelfTest = require(script.Parent.Dev.OrderSelfTest)
+
+local OrderSystem = {}
+
+export type Handle = {
+	OrderService: OrderService.OrderService,
+	ActionHandler: OrderActionHandler.OrderActionHandler,
+	Timeouts: OrderTimeoutService.Handle,
+	Destroy: () -> (),
+}
+
+local started = false
+
+function OrderSystem.Start(): Handle
+	assert(not started, "[OrderSystem] Start() sudah dipanggil.")
+	started = true
+	local config = OrderConfig
+	local inStudio = RunService:IsStudio()
+
+	if inStudio and config.Debug.RunSelfTest then
+		OrderSelfTest.Run(config)
+	end
+
+	local orderService = OrderService.new(config, { runId = "run_" .. string.sub(HttpService:GenerateGUID(false), 1, 8) })
+	local actionHandler = OrderActionHandler.new(orderService, config)
+	local remotes = OrderRemotes.Start(orderService, actionHandler, config)
+	local screen = OrderScreenService.Start(orderService, actionHandler, config)
+	actionHandler:SetInteractionPointProvider(function()
+		return screen.GetPosition()
+	end)
+	local timeouts = OrderTimeoutService.Start(orderService, config)
+
+	local harness: OrderDevHarness.Handle? = nil
+	if inStudio and config.Debug.EnableDevHarness then
+		harness = OrderDevHarness.Start(orderService, config)
+	end
+
+	return {
+		OrderService = orderService,
+		ActionHandler = actionHandler,
+		Timeouts = timeouts,
+		Destroy = function()
+			started = false
+			if harness then
+				harness.Destroy()
+			end
+			timeouts.Destroy()
+			screen.Destroy()
+			remotes.Destroy()
+			actionHandler:Destroy()
+			orderService:Destroy()
+		end,
+	}
+end
+
+return OrderSystem
