+++ b/src/ReplicatedStorage/Shared/Util/CurrencyFormat.luau
@@ -0,0 +1,19 @@
+--!strict
+--[[
+	CurrencyFormat — display-only Rupiah formatting (e.g. 1250000 -> "Rp1.250.000").
+	Money is stored as integer Rupiah everywhere else; format only inside UI.
+]]
+
+local CurrencyFormat = {}
+
+function CurrencyFormat.formatRupiah(amount: number): string
+	local rounded = math.floor(math.abs(amount) + 0.5)
+	local reversed = string.reverse(tostring(rounded))
+	local withDots = string.gsub(reversed, "(%d%d%d)", "%1.")
+	local restored = string.reverse(withDots)
+	restored = string.gsub(restored, "^%.", "")
+	local sign = if amount < 0 then "-" else ""
+	return sign .. "Rp" .. restored
+end
+
+return CurrencyFormat
diff --git a/src/ReplicatedStorage/Shared/Util/Signal.luau b/src/ReplicatedStorage/Shared/Util/Signal.luau
new file mode 100644
index 0000000..aa454da
--- /dev/null
+++ b/src/ReplicatedStorage/Shared/Util/Signal.luau
@@ -0,0 +1,42 @@
+--!strict
+--[[
+	Signal — tiny dependency-free signal used by server services.
+	Handlers run in their own thread (task.spawn), so a failing handler cannot break the emitter.
+]]
+
+local Signal = {}
+Signal.__index = Signal
+
+export type Connection = { Disconnect: (self: Connection) -> () }
+
+export type Signal = typeof(setmetatable({} :: {
+	_handlers: { [number]: (...any) -> () },
+	_nextId: number,
+}, Signal))
+
+function Signal.new(): Signal
+	return setmetatable({ _handlers = {}, _nextId = 0 }, Signal)
+end
+
+function Signal.Connect(self: Signal, handler: (...any) -> ()): Connection
+	self._nextId += 1
+	local id = self._nextId
+	self._handlers[id] = handler
+	local connection = {}
+	function connection.Disconnect(_: Connection)
+		self._handlers[id] = nil
+	end
+	return connection :: Connection
+end
+
+function Signal.Fire(self: Signal, ...: any)
+	for _, handler in self._handlers do
+		task.spawn(handler, ...)
+	end
+end
+
+function Signal.DisconnectAll(self: Signal)
+	table.clear(self._handlers)
+end
+
+return Signal
